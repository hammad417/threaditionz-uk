# Threaditionz storefront — environment variables.
# Copy to .env.local for local dev; add the same keys in Vercel
# (Project → Settings → Environment Variables) for Production + Preview.

# --- Shopify (required) ---
SHOPIFY_STORE_DOMAIN="[your-store].myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""   # read: products, cart, checkout, customers
SHOPIFY_ADMIN_ACCESS_TOKEN=""        # writes: media, shipping rules (server-only)
SHOPIFY_REVALIDATION_SECRET=""       # secures the cache webhook (see below)

# --- Site (required) ---
COMPANY_NAME="Threaditionz"
SITE_NAME="Threaditionz"
# Canonical production origin — drives canonical, sitemap, OG, JSON-LD.
# MUST be the final custom domain.
NEXT_PUBLIC_SITE_URL="https://threaditionz.co.uk"

# --- Commerce (optional) ---
# Cart free-shipping bar; MUST match a real Shopify free-shipping rule.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50"

# --- Analytics & ads tags (optional — each loads only when its ID is set; consent-gated) ---
# Standard ecommerce events (view_item / add_to_cart / begin_checkout) fire to GA4
# AND Meta from lib/analytics/ecommerce.ts. `purchase` fires on Shopify's hosted
# checkout — wire it in the Shopify admin (see launch/feed/SETUP-CHECKLIST.md).
NEXT_PUBLIC_GA_ID=""            # GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""    # Google Ads / Merchant remarketing tag, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=""      # Meta Pixel ID, e.g. 000000000000000
NEXT_PUBLIC_CLARITY_ID=""       # Microsoft Clarity project ID

# Domain-verification meta tags (set the token only; the tag is emitted when present)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""   # Google Search Console / Merchant Center token
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=""     # Meta Business domain-verification token

# --- PushOwl (optional — email/web-push opt-in + offers; consent-gated) ---
# The myshopify subdomain of the Shopify store the PushOwl app is installed on
# (e.g. "threaditionz-uk" for threaditionz-uk.myshopify.com). The headless SDK +
# /pushowl/service-worker.js load only when this is set. Opt-in popups, welcome
# offer and abandoned-cart automations are configured in the PushOwl dashboard.
NEXT_PUBLIC_PUSHOWL_SUBDOMAIN=""

# Shopify cache-revalidation webhook (configure in Shopify admin → Notifications → Webhooks):
#   POST https://<your-domain>/api/revalidate?secret=<SHOPIFY_REVALIDATION_SECRET>
#   Topics: products/create|update|delete, collections/create|update|delete
